# Local dev (docker-compose Postgres)
DATABASE_URL=postgresql+asyncpg://quotevault:quotevault@localhost:5432/quotevault

# Production (Neon) — use the pooled connection string, not the direct one.
# Use "ssl=require", not "sslmode=require" — asyncpg's connect() doesn't accept
# "sslmode" as a kwarg, and SQLAlchemy forwards URL query params verbatim.
# DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.neon.tech/quotevault?ssl=require

# LLM for auto-tagging and mood explanations (Google Gemini, free tier)
GEMINI_API_KEY=
